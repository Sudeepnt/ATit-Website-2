{
  "framework": null,
  "installCommand": "cd atit-capital-next && npm ci",
  "buildCommand": "cd atit-capital-next && STATIC_EXPORT=1 npm run build",
  "outputDirectory": "atit-capital-next/out",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/hero-story.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
